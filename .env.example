# Copia como .env.local solo si necesitas cambiarlo.
# Por defecto el frontend llama a "/api/..." en su mismo origen y el servidor de desarrollo (Vite)
# lo reenvía a http://localhost:8080, asi que NO hace falta definir nada.
#
# Solo si el frontend se sirve aparte del backend (otro dominio/puerto, sin proxy):
# VITE_API_URL=http://localhost:8080
# (entonces el backend debe incluir ese origen en CORS_ALLOWED_ORIGINS)
#
# Para que el proxy de desarrollo apunte a otro backend:
# VITE_PROXY_TARGET=http://192.168.1.50:8080
